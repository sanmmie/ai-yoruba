rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthed() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthed() && request.auth.uid == userId;
    }

    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if false;
      allow update: if isOwner(userId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName','preferences']);
      allow delete: if false;

      match /sessions/{sessionId} {
        allow read: if isOwner(userId);
        allow create, update: if false;
        allow delete: if isOwner(userId);

        match /messages/{messageId} {
          allow read: if isOwner(userId);
          allow create, update: if false;
          allow delete: if false;
        }
      }
    }

    match /stripeEvents/{eventId} {
      allow read, write: if false;
    }

    match /flwEvents/{eventId} {
      allow read, write: if false;
    }

    match /shares/{shareId} {
      allow read: if true;
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}