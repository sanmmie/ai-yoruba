rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthed() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthed() && request.auth.uid == userId;
    }

    // Phase 3 Path B: narrow client writes on sessions so create/rename/draft
    // work with src/modules/sessions.js. Prefer Path A (server-owned) later
    // when session ops move behind Cloud Functions / yorubaAIv2.
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if false;
      allow update: if isOwner(userId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'preferences'])
        && request.resource.data.get('displayName') is string
        && request.resource.data.get('preferences') is map;
      allow delete: if false;

      match /consents/{type} {
        allow read: if isOwner(userId);
        allow create, update, delete: if false;
      }

      match /sessions/{sessionId} {
        allow read: if isOwner(userId);

        // create: exact shape written by sessions.createSession
        allow create: if isOwner(userId)
          && request.resource.data.keys().hasOnly(['title', 'history', 'draft', 'createdAt', 'updatedAt'])
          && request.resource.data.title is string
          && request.resource.data.title.size() > 0
          && request.resource.data.title.size() <= 200
          && request.resource.data.history is list
          && request.resource.data.history.size() == 0
          && request.resource.data.draft is string
          && request.resource.data.draft.size() == 0;

        // update: title (rename), draft, history, updatedAt only
        allow update: if isOwner(userId)
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['title', 'history', 'draft', 'updatedAt'])
          && request.resource.data.title is string
          && request.resource.data.title.size() > 0
          && request.resource.data.title.size() <= 200
          && request.resource.data.history is list
          && request.resource.data.history.size() <= 100
          && request.resource.data.draft is string
          && request.resource.data.draft.size() <= 4000;

        allow delete: if isOwner(userId);

        match /messages/{messageId} {
          allow read: if isOwner(userId);
          allow create: if false;
          allow update: if isOwner(userId)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['feedback'])
            && request.resource.data.get('feedback') in ['up', 'down', null];
          allow delete: if false;
        }
      }

      match /leases/{leaseId} {
        allow read, write: if false;
      }

      match /reservations/{requestId} {
        allow read, write: if false;
      }
    }

    match /stripeEvents/{eventId} { allow read, write: if false; }
    match /flwEvents/{eventId} { allow read, write: if false; }
    match /reports/{reportId} { allow read, write: if false; }
    match /deletedUsers/{uid} { allow read, write: if false; }
    match /usageLogs/{logId} { allow read, write: if false; }
    match /usage/{key} { allow read, write: if false; }
    match /rateLimits/{key} { allow read, write: if false; }

    match /shares/{shareId} {
      allow read: if true;
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
