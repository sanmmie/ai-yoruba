{
    "name":  "yorubagpt",
    "version":  "2.0.0",
    "description":  "YorùbáGPT — Production AI conversational platform for the Yorùbá language",
    "private":  true,
    "type":  "module",
    "scripts":  {
                    "dev":  "vite",
                    "build":  "vite build",
                    "preview":  "vite preview",
                    "lint":  "eslint src --ext .js",
                    "lint:fix":  "eslint src --ext .js --fix",
                    "functions:dev":  "cd functions \u0026\u0026 npm run serve",
                    "functions:deploy":  "cd functions \u0026\u0026 firebase deploy --only functions",
                    "deploy":  "npm run build \u0026\u0026 firebase deploy"
                },
    "devDependencies":  {
                            "eslint":  "^8.57.0",
                            "terser":  "^5.49.0",
                            "vite":  "^8.1.3",
                            "firebase-admin":  "^12.4.0"
                        },
    "dependencies":  {
                         "dompurify":  "^3.4.17",
                         "firebase":  "^12.15.0",
                         "marked":  "^18.1.1"
                     }
}