{
  "name": "yorubagpt",
  "version": "2.0.0",
  "description": "YorùbáGPT — Production AI conversational platform for the Yorùbá language",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint src --ext .js",
    "lint:fix": "eslint src --ext .js --fix",
    "functions:dev": "cd functions && npm run serve",
    "functions:deploy": "cd functions && firebase deploy --only functions",
    "deploy": "npm run build && netlify deploy --prod --dir=dist"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "vite": "^8.1.3"
  }
}
