# .env.example — copy to .env.local, fill in values, never commit .env.local

VITE_FIREBASE_API_KEY=AIzaSy...
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
VITE_FIREBASE_APP_ID=1:123456789:web:abcdef

# Leave blank to use Firebase callable SDK (recommended)
VITE_AI_ENDPOINT=

# Set to true to connect to Firebase emulators locally
VITE_USE_EMULATORS=false

# Optional: override chat/stream endpoint (dev/emulator or direct function URL)
VITE_AI_STREAM_ENDPOINT=

# Functions (server-side; set via Firebase Functions env/Secret Manager, not in frontend .env)
# ANTHROPIC_API_KEY=
# POLICY_VERSION=
# APP_URL=https://ai-yoruba.web.app
# ALLOWED_ORIGINS=https://ai-yoruba.web.app,https://ai-yoruba.firebaseapp.com
